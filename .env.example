# Google ADK
GEMINI_API_KEY=
ADK_AGENT_URL=http://127.0.0.1:8000/orchestrate
LIVE_SESSION_SECRET=
LIVE_THINKING_LEVEL=medium
LIVE_VOICE_NAME=Sulafat

# Handoff autónomo LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WEBMCP_TENANT_ID=baterias-power-demo
ADVISOR_ACCESS_TOKEN=

# Local checkout: explicit simulation or PagoPlux sandbox. Production charges are disabled.
PAYMENT_MODE=pagoplux_sandbox
PAGOPLUX_ENVIRONMENT=sandbox
PAGOPLUX_MERCHANT_EMAIL=info@fullsegura.com
PAGOPLUX_WEBHOOK_BASIC_TOKEN=

# Optional: own/managed Nominatim reverse endpoint. No Google API keys needed.
NOMINATIM_REVERSE_URL=
# Explicit public-service opt-in for a single-instance, single-web-process demo only.
# Do not enable on concurrent revisions or multiple instances/processes.
NOMINATIM_PUBLIC_DEMO_ENABLED=false
